{ "id": "app-launcher", "name": "App Launcher", "version": "1.0.0", "apiVersion": 1, "author": "Windows Customization Hub",
  "category": "Productivity", "description": "Быстрый запуск ваших приложений из красивой панели по горячей клавише. Список приложений вы собираете сами.",
